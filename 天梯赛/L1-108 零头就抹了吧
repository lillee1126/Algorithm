#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
void solve(){
    int n;
    cin>>n;
    int cnt=0;
    while(n/2){
        n/=2;
        cnt++;
    }
    int ans=1;
    for(int i=0;i<cnt;i++){
        ans*=2;
    }
    cout<<ans;
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	solve();
	return 0;
}
