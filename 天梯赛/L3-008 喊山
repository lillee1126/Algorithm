#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
int n,m,k;
const int N=10010;
vector<int> e[N];
int vis[N];
int bfs(int cnt,int cur,int ans){
    queue<pair<int,int>> q;
    q.push({cur,cnt});
    int now=cnt;
    vis[cur]=1;
    while(!q.empty()){
        auto t=q.front();
        q.pop();
        for(int i=0;i<e[t.first].size();i++){
            if(!vis[e[t.first][i]]){
                vis[e[t.first][i]]=1;
                q.push({e[t.first][i],t.second+1});
                if(now<t.second+1){
                    now=t.second+1;
                    ans=e[t.first][i];
                }
                else if(now==t.second+1){
                    ans=min(ans,e[t.first][i]);
                }
            }
        }
    }
    return ans;
}
void solve(){
	cin>>n>>m>>k;
    for(int i=1;i<=m;i++){
        int a,b;
        cin>>a>>b;
        e[a].push_back(b);
        e[b].push_back(a);
    }
    while(k--){
        memset(vis,0,sizeof vis);
        int t;
        cin>>t;
        if(e[t].size()==0){
            cout<<0<<endl;
            continue;
        }
        cout<<bfs(0,t,INT_MAX)<<endl;
    }
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	solve();
	return 0;
}
