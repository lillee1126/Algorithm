#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
map<int,vector<int>> m;
void cnt(int t){
    int n=0;
    string s= to_string(t);
    while(s.size()>1){
        int temp=1;
        for(int i=0;i<s.size();i++){
            temp*=s[i]-'0';
        }
        s= to_string(temp);
        n++;
    }
    m[n].push_back(t);
}
void solve(){
    int a,b;
    cin>>a>>b;
    for(int i=a;i<=b;i++){
        cnt(i);
    }
    auto it=--m.end();
    cout<<it->first<<endl;
    for(int i=0;i<it->second.size();i++){
        if(i!=0){
            cout<<' ';
        }
        cout<<it->second[i];
    }
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	solve();
	return 0;
}
