#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
struct node{
    string b,e;
};
const int N=1e5+10;
int n;
node t[N];
bool f(node aa,node bb){
    return aa.b<bb.b;
}
void solve(){
    cin>>n;
    for(int i=1;i<=n;i++){
        cin>>t[i].b>>t[i].e;
    }
    sort(t+1,t+1+n,f);
    int ans=1;
    priority_queue<string,vector<string>,greater<>> q;
    q.push(t[1].e);//有熊猫用
    for(int i=2;i<=n;i++){
        if(t[i].b>q.top()){
            q.pop();
            q.push(t[i].e);
        }
        else{
            ans++;
            q.push(t[i].e);
        }
    }
    cout<<ans;
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	solve();
	return 0;
}
