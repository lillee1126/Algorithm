#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
int n;
const int N=110;
struct node{
    int val,l,r,d;
};
node a[N];
map<int,int> mp;
void build(int cur,int f){
    if(a[cur].val>a[f].val){
        if(!a[f].r){
            a[f].r=cur;
            a[cur].d=a[f].d+1;
        }
        else{
            build(cur,a[f].r);
        }
    }
    else{
        if(!a[f].l){
            a[f].l=cur;
            a[cur].d=a[f].d+1;
        }
        else{
            build(cur,a[f].l);
        }
    }
}
int jx(string s){
    return stoll(s);
}
void solve(){
    cin>>n;
    for(int i=1;i<=n;i++){
        cin>>a[i].val;
        a[i].l=0;
        a[i].r=0;
        mp[a[i].val]=i;
