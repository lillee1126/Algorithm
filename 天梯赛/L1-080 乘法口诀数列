#include<bits/stdc++.h>
using namespace std;
#define int long long
#define endl '\n'
int a,b,n;
vector<int> ans;
void ps(int t){
    if(t<=9){
        ans.push_back(t);
    }
    else{
        string s=to_string(t);
        for(int i=0;i<s.size();i++){
            ans.push_back(s[i]-'0');
        }
    }
}
void solve(){
    cin>>a>>b>>n;
    ans.push_back(a);
    ans.push_back(b);
    int cur=0;
    while(ans.size()<n){
        int t=ans[cur]*ans[cur+1];
        ps(t);
        cur++;
    }
    for(int i=0;i<n;i++){
        if(i)
            cout<<" ";
        cout<<ans[i];
    }
}
signed main(){
    ios::sync_with_stdio(0);
    cin.tie(0);
    solve();
    return 0;
}
