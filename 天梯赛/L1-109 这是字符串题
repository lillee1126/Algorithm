#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
void solve(){
    string s;
    cin>>s;
    map<int,int> m;
    int a[26];
    for(int i=0;i<26;i++){
        cin>>a[i];
    }
    for(int i=0;i<26;i++){
        m[i]=0;
    }
    for(int i=0;i<s.size();i++){
        m[s[i]-'a']++;
    }
    int ans=0;
    for(auto it=m.begin();it!=m.end();it++){
        if(it!=m.begin()){
            cout<<' ';
        }
        ans+=it->second*a[it->first];
        cout<<it->second;
    }
    cout<<endl;
    cout<<ans;
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	solve();
	return 0;
}
