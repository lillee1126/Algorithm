#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
int n,m,k;
const int N=1e3+10;
int a[N];
void solve(){
    for(int i=1;i<=n;i++){
        cin>>a[i];
    }
    stack<int> s;
    int cur=1;
    for(int i=1;i<=n;i++){
        if(s.size()>m){
            cout<<"NO"<<endl;
            return;
        }
        
        if(a[i]==cur){
            cur++;
        }
        else{
            if(!s.empty()){
                if(s.top()<a[i]){
                    cout<<"NO"<<endl;
                    return;
                }
            }
            s.push(a[i]);
        }
        while(!s.empty()&&s.top()==cur){
            cur++;
            s.pop();
        }
    }
    cout<<"YES"<<endl;
}
signed main(){
    ios::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
    cin>>n>>m>>k;
    while(k--)
        solve();
    return 0;
}
