#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
int n;
const int N=1e4+10;
int a[N];
double sum=0;
map<int,string> m;
void solve() {
    cin>>n;
    for(int i=1;i<=n;i++){
        string s;
        cin>>s>>a[i];
        m[i]=s;
        sum+=a[i];
    }
    sum=sum/n;
    sum/=2.0;
    pair<int,int> ans={-1,INT_MAX};
    for(int i=1;i<=n;i++){
        int t=abs(sum-a[i]);
        if(ans.second>t){
            ans={i,t};
        }
    }
    printf("%.0f",sum);
    cout<<' '<<m[ans.first];
}

signed main() {
    solve();
    return 0;
}
