#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
const int N=110;
float a[N];
void solve(){
	int n;
    cin>>n;
    double ans=0;
    map<int,int> m;
    for(int i=1;i<=n;i++){
        cin>>a[i];
        m[i]=0;
    }
    while(1){
        int p,q;
        cin>>p>>q;
        if(p==0){
            break;
        }
        m[p]+=q;
        ans+=a[p]*q;
    }
    for(auto it:m){
        cout<<it.second<<endl;
    }
    printf("%.2f",ans);
}
signed main(){
	solve();
	return 0;
}
