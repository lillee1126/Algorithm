#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
map<int,int> m1;
map<int,int> m2;
int n,k,s;
vector<int> tj;
void solve(){
    cin>>n>>k>>s;
    for(int i=1;i<=n;i++){
        int a,b;
        cin>>a>>b;
        if(a>=175){
            if(m1.count(a)!=1)
                tj.push_back(a);
            m1[a]++;
            if(b>=s){
                m2[a]++;
            }
        }
    }
    sort(tj.begin(),tj.end(),greater());
    int ans=0;
    for(int i=0;i<tj.size();i++){
        if(m1[tj[i]]<=k){
            ans+=m1[tj[i]];
        }
        else{
            ans+=k;
            ans+=min(m2[tj[i]],m1[tj[i]]-k);
        }
    }
    cout<<ans;
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	solve();
	return 0;
}
