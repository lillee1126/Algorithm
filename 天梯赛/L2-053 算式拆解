#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
void solve() {
    string s;
    cin>>s;
    stack<char> st;
    for(int i=0;i<s.size();){
        if(s[i]!=')'){
            st.push(s[i]);
            i++;
        }
        else{
            string t="";
            while(!st.empty()&&st.top()!='('){
                t+=st.top();
                st.pop();
            }
            if(!st.empty()&&st.top()=='('){
                st.pop();
            }
            for(int j=t.size()-1;j>=0;j--){
                cout<<t[j];
            }
            i++;
            cout<<endl;
        }
    }
}

signed main() {
    solve();
    return 0;
}
