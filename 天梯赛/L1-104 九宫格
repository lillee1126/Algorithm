#include <bits/stdc++.h>

#define int long long
#define endl '\n'
using namespace std;

void solve() {
    int a[10][10];
    for (int i = 1; i <= 9; i++) {
        for (int j = 1; j <= 9; j++) {
            cin >> a[i][j];
            }
    }
    for (int i = 1; i <= 9; i++) {
        for (int j = 1; j <= 9; j++) {
            if (a[i][j] > 9 || a[i][j] < 1) {
                cout << 0 << endl;
                return;
            }
        }
    }
    for(int i=1;i<=9;i++){
        map<int,int> cnt;
        for(int j=1;j<=9;j++){
            if (cnt.count(a[i][j])) {
                cout << 0 << endl;
                return;
            }
            cnt[a[i][j]]++;
        }
    }
    for(int i=1;i<=9;i++){
        map<int,int> cnt;
        for(int j=1;j<=9;j++){
            if (cnt.count(a[j][i])) {
                cout << 0 << endl;
                return;
            }
            cnt[a[j][i]]++;
        }
    }
    for (int k = 0; k < 3; k++) {
        for (int p = 0; p < 3; p++) {
            map<int, int> cnt;
            for (int i = 1 + 3 * k; i <= 3 + 3 * k; i++) {
                for (int j = 1 + 3 * p; j <= 3 + 3 * p; j++) {
                    if (cnt.count(a[i][j])) {
                        cout << 0 << endl;
                        return;
                    }
                    cnt[a[i][j]]++;
                }
            }
        }
    }
    cout << 1 << endl;
}

signed main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
