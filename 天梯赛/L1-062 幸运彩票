#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
void solve() {
    int t;
    cin>>t;
    while(t--){
        string s;
        cin>>s;
        int a=0;
        int b=0;
        for(int i=0;i<3;i++){
            a+=s[i]-'0';
        }
        for(int i=3;i<6;i++){
            b+=s[i]-'0';
        }
        if(a==b){
            cout<<"You are lucky!"<<endl;
        }
        else{
            cout<<"Wish you good luck."<<endl;
        }
    }
}

signed main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
    solve();
    return 0;
}
