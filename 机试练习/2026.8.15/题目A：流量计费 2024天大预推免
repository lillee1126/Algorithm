#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
void solve(){
    int n;
    cin>>n;
    int sum=0;
    for(int i=0;i<n;i++){
        int t;
        cin>>t;
        sum+=t;
    }
    int ans=0;
    if(sum<=500){
        ans=10;
    }
    else{
        ans=sum-500+10;
    }
    cout<<ans<<endl;
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	int t;
	cin>>t;
	while(t--){
    	solve();
    }
	return 0;
}
