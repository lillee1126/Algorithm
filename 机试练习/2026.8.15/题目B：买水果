#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
int n,m;
const int N=1e3+10;
int a[N],b[N];
void solve(){
    cin>>n>>m;
    for(int i=1;i<=n;i++){
        cin>>a[i];
    }
    for(int i=1;i<=m;i++){
        cin>>b[i];
    }
    int ans=0;
    sort(a+1,a+1+n);
    sort(b+1,b+1+m);
    int i=n,j=m;
    while(i>0&&j>0){
        if(a[i]>b[j]){
            ans++;
            i--;
            j--;
        }
        else if(a[i]<=b[j]){
            j--;
        }
    }
    cout<<ans<<endl;
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	int t;
	cin>>t;
	while(t--){
    	solve();
    }
	return 0;
}
