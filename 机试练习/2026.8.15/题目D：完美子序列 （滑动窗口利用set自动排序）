#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
const int N=50010;
int n,m;
int a[N];
void solve(){
    set<int> s;
    map<int,int> mp;
    cin>>n>>m;
    for(int i=1;i<=n;i++){
        cin>>a[i];
    }
    int md=a[1],mx=a[1];
    mp[a[1]]++;
    int l=1,r=2;
    int ans=1;
    s.insert(a[1]);
    while(r<=n){
        s.insert(a[r]);
        mp[a[r]]++;
        md=*(--s.end());
        mx=*s.begin();
        if(md-mx<=m){
            ans=max(ans,r-l+1);
            r++;
        }
        else{
            while(md-mx>m){
                mp[a[l]]--;
				if(mp[a[l]]==0)
   					 s.erase(a[l]);
                l++;
                md=*(--s.end());
                mx=*s.begin();
            }
            ans=max(ans,r-l+1);
            r++;
        }
    }
    cout<<ans<<endl;
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	int t;
	cin>>t;
	while(t--){
    	solve();
    }
	return 0;
}
