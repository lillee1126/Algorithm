#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
int n,m;
const int N=1e5+10;
string a[100*N];
map<string,int> mp;
void solve(){
    cin>>n;
    for(int i=1;i<=n;i++){
        string s;
        cin>>s;
        mp[s]=0;
    }
    cin>>m;
    for(int i=1;i<=m;i++){
        cin>>a[i];
    }
    int ans1=0;
    for(int i=1;i<=m;i++){
        if(mp.count(a[i])&&mp[a[i]]==0){
            ans1++;
            mp[a[i]]=1;
        }
    }
    cout<<ans1<<endl;
    map<string,queue<int>> pre;//当前窗口中出现s的位置(需要背诵的)
    int l=1,r=1;
    int cnt=0;
    int ans=INT_MAX;
    while(cnt<ans1){
        if(mp.count(a[r])){
            if(pre.count(a[r])!=1)
                cnt++;
            pre[a[r]].push(r);
            if(cnt==ans1)
                break;
        }
        r++;
    }
    ans=r-l+1;
    while(r<=m){
        while(mp.count(a[l])!=1||pre[a[l]].size()>1){
            if(mp.count(a[l])!=1){
                l++;
                continue;
            }
            pre[a[l]].pop();
            l++;
        }
        ans=min(ans,r-l+1);
        r++;
        if(a[l]==a[r]){
            pre[a[l]].pop();
            pre[a[l]].push(r);//一定要先操作再修改
            l++;
        }
        ans=min(ans,r-l+1);
    }
    cout<<ans;
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	solve();
	return 0;
}
