//https://leetcode.cn/problems/car-fleet-ii/
class Solution {
public:
    vector<double> getCollisionTimes(vector<vector<int>>& cars) {
        stack<pair<int,double>> s;//需要追的车
        int n=cars.size();
        vector<double> ans(n);
        ans[n-1]=-1;
        s.push({n-1,-1});
        for(int i=n-2;i>=0;i--){
            while(!s.empty()&&cars[i][1]<=cars[s.top().first][1]){
                s.pop();
            }
            if(s.empty()){
                ans[i]=-1;
                s.push({i,-1});
                continue;
            }
            double t;
            t =(cars[s.top().first][0]-cars[i][0])/((double)(cars[i][1]-cars[s.top().first][1]));
            while(!s.empty()&&t>s.top().second&&s.top().second!=-1){
                s.pop();
                t =(cars[s.top().first][0]-cars[i][0])/((double)(cars[i][1]-cars[s.top().first][1]));
            }
            if(s.empty()){
                t=-1;
            }
            ans[i]=t;
            s.push({i,t});
        }
        return ans;
    }
};
