class Solution {
public:
    long long change(int amount, vector<int>& coins) {
        unsigned long long dp[10010];
        memset(dp, 0, sizeof(dp));
        dp[0] = 1;
        for (int i = 0; i < coins.size(); i++) {
            int coin = coins[i];
            for (int j = coin; j <= amount; j++) {
                dp[j] += dp[j - coin];
            }
        }
        return dp[amount];
    }
};
