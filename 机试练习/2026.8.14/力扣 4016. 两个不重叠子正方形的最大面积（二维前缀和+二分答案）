class Solution {
    int a[510][510];
    int n, m;

public:
    bool check(int t) {
        int minx = n + 1, maxx = -1;
        int miny = m + 1, maxy = -1;

        for (int i = 1; i <= n - t + 1; i++) {
            for (int j = 1; j <= m - t + 1; j++) {
                int x = a[i + t - 1][j + t - 1]
                      - a[i + t - 1][j - 1]
                      - a[i - 1][j + t - 1]
                      + a[i - 1][j - 1];

                if (x == t * t) {
                    minx = min(minx, i);
                    maxx = max(maxx, i);

                    miny = min(miny, j);
                    maxy = max(maxy, j);

                    if (maxx - minx >= t || maxy - miny >= t) {
                        return true;
                    }
                }
            }
        }

        return false;
    }

    int maxArea(vector<vector<int>>& mat) {

        int cnt = 0;
        n = mat.size();
        m = mat[0].size();

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= m; j++) {
                cnt += mat[i - 1][j - 1];

                a[i][j] = a[i - 1][j]
                        + a[i][j - 1]
                        - a[i - 1][j - 1]
                        + mat[i - 1][j - 1];
            }
        }

        if (cnt < 2) {
            return 0;
        }

        int l = 1;
        int r = min({n, m, (int)sqrt(cnt / 2)});

        while (l < r) {
            int mid = (l + r + 1) / 2;

            if (check(mid)) {
                l = mid;
            } else {
                r = mid - 1;
            }
        }

        return l * l;
    }
};
