#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
string s;
void solve(){
    int n=s.size();
    vector<vector<bool>> dp(n, vector<bool>(n, false));
    for(int i=0;i<s.size();i++){
        dp[i][i]=1;
    }
    int ans=s.size();
    for(int r=1;r<s.size();r++){
        for(int l=0;l<r;l++){
            if(s[l]==s[r]){
                if(r-l+1<=3){
                    ans++;
                    dp[l][r]=1;
                }
                else{
                    dp[l][r]=dp[l+1][r-1];
                    ans+=dp[l][r];
                }
            }
        }
    }
    cout<<ans<<endl;
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	while(cin>>s)
        solve();
	return 0;
}
