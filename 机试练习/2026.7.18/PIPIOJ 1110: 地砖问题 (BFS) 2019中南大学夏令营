//http://pipioj.online/problem.php?id=1110
#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
int n,m;
char a[30][30];
bool vis[30][30];
int flag=0;
int dir[4][2]={{0,1},{0,-1},{1,0},{-1,0}};
void solve(){
    cin>>m>>n;
    if(n==0&&m==0){
        flag=1;
        return ;
    }
    memset(vis,0,sizeof vis);
    int sx,sy;
    for(int i=1;i<=n;i++){
        for(int j=1;j<=m;j++){
            cin>>a[i][j];
            if(a[i][j]=='@'){
                sx=i;
                sy=j;
            }
        }
    }
    queue<pair<int,int>> q;
    q.push({sx,sy});
    int ans=1;
    vis[sx][sy]=1;
    while(!q.empty()){
        auto t=q.front();
        q.pop();
        int x=t.first,y=t.second;
        for(int i=0;i<4;i++){
            int dx=x+dir[i][0];
            int dy=y+dir[i][1];
            if(dx>0&&dx<=n&&dy>0&&dy<=m&&a[dx][dy]=='.'&&!vis[dx][dy]){
                vis[dx][dy]=1;
                ans++;
                q.push({dx,dy});
            }
        }
    }
    cout<<ans<<endl;
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	while(1){
    	solve();
        if(flag){
            break;
        }
    }
	return 0;
}
