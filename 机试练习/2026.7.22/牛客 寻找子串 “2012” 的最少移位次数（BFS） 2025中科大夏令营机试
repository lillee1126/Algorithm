#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
string sp(string s,int a,int b){
    char t=s[a];
    s[a]=s[b];
    s[b]=t;
    return s;
}
bool check(string s){
    for(int i=0;i<=s.size()-4;i++){
        if(s[i]=='2'&&s[i+1]=='0'&&s[i+2]=='1'&&s[i+3]=='2'){
            return 1;
        }
    }
    return 0;
}
void solve(){
    int n;
    string s;
    while(cin>>n>>s) {
        int find=0;
        map<string,int> mp;
        queue<pair<int, string>> q;
        q.push({0, s});
        while (!q.empty()) {
            auto t = q.front();
            q.pop();
            string cur = t.second;
            mp[cur]++;
            if (check(cur)) {
                cout << t.first << endl;
                find=1;
                break;
            }
            for (int i = 0; i < cur.size() - 1; i++) {
                string ns = sp(cur, i, i + 1);
                if(mp.count(ns)!=1){
                q.push({t.first + 1, ns});
                }
            }
        }
        if(find==0){
            cout<<-1<<endl;
        }
    }
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	solve();
	return 0;
}
