/*
题目描述
给定一个字符串 S 和一个整数 N，要求统计所有满足以下条件的子串的个数：子串中每个符的数目不超过 N。

注意：是子串，不是子序列。

输入格式
第一行输入一个整数 T (1≤T≤1000)，表示测试数据的组数。

每组测试数据包含两行：

第一行是一个整数 N (1≤N≤100)，表示子串中每个字符的数目不能超过的值。

第二行是一个字符串 S (1≤∣S∣≤10000)，表示输入的字符串。

输出格式
对于每组测试数据，输出一个整数 M，表示符合条件的子串的个数。

输入样例
3
1
abc
1
abcabc
2
abcabc

输出样例
6
15
21
*/
#include <bits/stdc++.h>
#define int long long
#define endl '\n'
using namespace std;
void solve(){
    int n;
    string s;
    cin>>n>>s;
    map<char,int> m;
    int ans=0;
    int l=0,r=0;
    while(l<=r&&l<s.size()&&r<s.size()){
        m[s[r]]++;
        if(m[s[r]]<=n){
            ans+=r-l+1;
            r++;
        }
        else{
            while (m[s[r]]>n){
                m[s[l]]--;
                l++;
            }
            ans+=r-l+1;
            r++;
        }
    }
    cout<<ans<<endl;
}
signed main(){
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	int t;
	cin>>t;
	while(t--){
    	solve();
    }
	return 0;
}
